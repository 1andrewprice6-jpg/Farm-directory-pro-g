rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 1. Farms
    match /farms/{farmId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && incoming().name is string && incoming().name.size() <= 200
        && incoming().address is string && incoming().address.size() <= 500;
      allow update: if isSignedIn()
        && incoming().name is string && incoming().name.size() <= 200
        && incoming().address is string && incoming().address.size() <= 500;
      allow delete: if isSignedIn(); // In a real app we might restrict this further
    }

    // 2. Vehicles
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().name is string && incoming().name.size() <= 100;
      allow update: if isSignedIn() && incoming().name is string && incoming().name.size() <= 100;
      allow delete: if isSignedIn();
    }

    // 3. Fuel Logs
    match /fuelLogs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid
        && incoming().gallonsPumped is number
        && incoming().odometerReading is number;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 4. Catch Logs
    match /catchLogs/{logId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // 5. User Settings
    match /userSettings/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }
  }
}
